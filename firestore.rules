rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'ae8860971@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Books catalog
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lessons catalog & textbook content
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Games catalog
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live Classes
    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.studentEmail == request.auth.token.email);
    }

    // Availability slots
    match /availability/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Memberships plans
    match /memberships/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student progress
    match /progress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Game attempts / scores
    match /gameAttempts/{attemptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Book purchases & subscriptions
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated();
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if true; // Public verification allowed
      allow write: if isAdmin();
    }

    // Site settings & CMS configuration
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email templates
    match /emailTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
